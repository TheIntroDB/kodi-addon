<?xml version="1.0" encoding="UTF-8"?>
<!-- Texture paths are full `special://home/addons/...` paths on purpose.

     Kodi resolves a texture name through CGUITextureManager::GetTexturePath, which uses
     the name as-is only when CURL::IsFullPath says so (it starts with "/" or contains
     "://"). Everything else is looked for under the *active skin's* media folder, never
     the add-on's own skin folder, so a relative "pill.png" resolves to nothing: the pill
     draws invisible and only its label shows. The image-based pills this replaced got
     away with relative names because Python set their paths absolutely
     (ControlImage.setImage); a button has no texture setter — CGUIButtonControl exposes
     SetLabel and SetLabel2 only — so the path has to be written here.
-->
<!-- Classic pills (the look the add-on shipped before styles existed).

     One <control type="button"> per pill, drawn with the 9-slice texture
     rounded_rect.png and tinted per pill with colordiffuse — no background <image>
     controls, because an image cannot follow the label (Kodi only auto-sizes
     button, togglebutton and grouplist: CGUIButtonControl::GetWidth returns
     CLAMP(textwidth + 2 * offsetX, min, max)).

     <width min="350" max="390">auto</width>: the box hugs the label, floored at the
     design width — the widest label the pills can show across the six shipped
     languages measures 295px in this font (Polish "Pomiń napisy końcowe"), and 350
     leaves that label room inside the corners — and capped at 390, where a longer
     translation starts to scroll.

     Kodi works a control's position out from its left edge before the label is
     measured, so an auto-width control can only be anchored by its left edge. The
     group is placed so the 350px pill ends where the old 260px pill ended, 50px from
     the screen edge; the pills grow into the 40px of slack to their right. -->
<window type="dialog" id="14000">
    <defaultcontrol always="true">3001</defaultcontrol>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="group">
            <posx>1520</posx>
            <posy>850</posy>
            <width>390</width>
            <height>104</height>

            <animation effect="slide" start="40,0" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="40,0" time="200" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

            <!-- Skip pill (primary) -->
            <control type="button" id="3001">
                <posx>0</posx>
                <posy>0</posy>
                <width min="350" max="390">auto</width>
                <height>48</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font20</font>
                <textcolor>FF111111</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus colordiffuse="FFFFFFFF" border="14">special://home/addons/plugin.video.tidb/resources/skins/default/1080i/rounded_rect.png</texturefocus>
                <texturenofocus colordiffuse="FFF8F8F8" border="14">special://home/addons/plugin.video.tidb/resources/skins/default/1080i/rounded_rect.png</texturenofocus>
                <label>Skip intro</label>
            </control>

            <!-- Report pill (secondary), directly under the skip pill. It carries no
                 <visible> condition: Kodi's Control.setVisible can hide a control
                 but never show one a condition hides, so overlay.py decides (and
                 the mark-intro overlay, which shares this XML, hides it). -->
            <control type="button" id="3002">
                <posx>0</posx>
                <posy>56</posy>
                <width min="350" max="390">auto</width>
                <height>48</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font20</font>
                <textcolor>FFF0F0F0</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF3A3A3A" border="14">special://home/addons/plugin.video.tidb/resources/skins/default/1080i/rounded_rect.png</texturefocus>
                <texturenofocus colordiffuse="B0000000" border="14">special://home/addons/plugin.video.tidb/resources/skins/default/1080i/rounded_rect.png</texturenofocus>
                <label>Report</label>
            </control>
        </control>
    </controls>
</window>
