<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip pill: 9-slice rounded_rect.png (border must be < half of bar height). Texture paths also set from Python onInit for reliable load. -->
<window type="dialog" id="14000">
    <defaultcontrol always="true">3001</defaultcontrol>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="group">
            <posx>1610</posx>
            <posy>880</posy>
            <width>260</width>
            <height>104</height>

            <animation effect="slide" start="40,0" end="0,0" time="260" tween="cubic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="260">WindowOpen</animation>
            <animation effect="slide" start="0,0" end="40,0" time="200" tween="cubic" easing="in">WindowClose</animation>
            <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

            <!-- Skip pill (primary) -->
            <control type="image" id="3003">
                <posx>1</posx>
                <posy>2</posy>
                <width>260</width>
                <height>48</height>
                <aspectratio>stretch</aspectratio>
                <texture colordiffuse="55000000" border="14">rounded_rect.png</texture>
            </control>

            <control type="image" id="3004">
                <posx>0</posx>
                <posy>0</posy>
                <width>260</width>
                <height>48</height>
                <aspectratio>stretch</aspectratio>
                <texture colordiffuse="FFF8F8F8" border="14">rounded_rect.png</texture>
            </control>

            <control type="button" id="3001">
                <posx>0</posx>
                <posy>0</posy>
                <width>260</width>
                <height>48</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font20</font>
                <textcolor>FF111111</textcolor>
                <focusedcolor>FF000000</focusedcolor>
                <texturefocus colordiffuse="FFFFFFFF" border="14">rounded_rect.png</texturefocus>
                <texturenofocus colordiffuse="FFF8F8F8" border="14">rounded_rect.png</texturenofocus>
                <label>Skip intro</label>
            </control>

            <!-- Report pill (secondary), directly under the skip pill. Ships hidden
                 and is shown from Python only when the add-on offers reporting, so
                 the mark-intro overlay, which shares this XML, never draws it. -->
            <control type="image" id="3005">
                <posx>1</posx>
                <posy>58</posy>
                <width>260</width>
                <height>48</height>
                <aspectratio>stretch</aspectratio>
                <texture colordiffuse="55000000" border="14">rounded_rect.png</texture>
                <visible>false</visible>
            </control>

            <control type="image" id="3006">
                <posx>0</posx>
                <posy>56</posy>
                <width>260</width>
                <height>48</height>
                <aspectratio>stretch</aspectratio>
                <texture colordiffuse="B0000000" border="14">rounded_rect.png</texture>
                <visible>false</visible>
            </control>

            <control type="button" id="3002">
                <posx>0</posx>
                <posy>56</posy>
                <width>260</width>
                <height>48</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font20</font>
                <textcolor>FFF0F0F0</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus colordiffuse="FF3A3A3A" border="14">rounded_rect.png</texturefocus>
                <texturenofocus colordiffuse="B0000000" border="14">rounded_rect.png</texturenofocus>
                <label>Report</label>
                <visible>false</visible>
            </control>
        </control>
    </controls>
</window>
